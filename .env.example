KeyVaultUri=https://your-vault.vault.azure.net/
SquareOAuthRedirectUri=https://your-app.azurewebsites.net/square/oauth/callback
PORT=3000

# WEBSITE_HOSTNAME is auto-injected by Azure App Service; the Square OAuth redirect and allowed
# hosts/origins are derived from it (or from localhost:PORT when running locally).

# Enterprise identity is proven by Azure App Service Authentication ("Easy Auth"), configured on the
# App Service resource itself - not by this app. Enable "Authentication" on the App Service, add a
# Microsoft Entra ID identity provider, and set "Require authentication". No Entra app
# secrets/signing keys are read by this app; the platform injects the caller's identity via
# X-MS-CLIENT-PRINCIPAL* request headers.

# EasyAuthDevPrincipal - local-only override so /mcp works without App Service Authentication when
# running `npm run dev`. Format: "tenantId:objectId[:displayName]". Ignored whenever WEBSITE_HOSTNAME
# is set, so it can never activate on a real App Service deployment. Do not set in production.
# EasyAuthDevPrincipal=00000000-0000-0000-0000-000000000000:11111111-1111-1111-1111-111111111111:Dev User

# Additional Key Vault secrets this deployment expects (no corresponding env vars):
#   Square-AppId, Square-AppSecret, Square-Environment  - this app's Square OAuth application credentials
#   Square-OAuthStateSigningKey                         - HMAC key for the "Connect Square" link/state tokens
#   Square-TipPreviewSigningKey                         - HMAC key for reconcile/commit cash-tips preview tokens

KeyVaultUri=https://your-vault.vault.azure.net/
SquareOAuthRedirectUri=https://your-app.azurewebsites.net/square/oauth/callback
PORT=3000

# WEBSITE_HOSTNAME is auto-injected by Azure App Service; the broker's issuer, JWKS, and Entra
# redirect URIs are all derived from it (or from localhost:PORT when running locally).

# Additional Key Vault secrets this deployment expects (no corresponding env vars):
#   Entra-TenantId, Entra-ClientId, Entra-ClientSecret  - the broker's confidential-client Entra app registration
#   Mcp-BrokerSigningKey                                - generated automatically on first run, do not set manually
